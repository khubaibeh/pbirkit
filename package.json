{
	"name": "pbirkit",
	"private": true,
	"description": "[EXPERIMENTAL] Tool(s) for interacting with power bi reports.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"prepare": "vp config",
		"build": "pnpm -r build",
		"check": "effect-tsgo vp check",
		"lint": "effect-tsgo vp lint",
		"lint:fix": "effect-tsgo vp lint --fix",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"typecheck": "pnpm -r typecheck",
		"test": "vp test run"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.13.1",
			"onFail": "download"
		}
	}
}

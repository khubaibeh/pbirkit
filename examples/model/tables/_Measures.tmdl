	/// KPI card note for units sold.
	measure 'Units Sold vs PY Label' =
			VAR _change = [Units Sold YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( 'Date'[Year] ), "Pick one year to compare",
			        ISBLANK ( _change ), "No prior-year data",
			        FORMAT ( _change, "▲ 0%;▼ 0%;0%" ) & " vs last year"
			    )
		displayFolder: Report
		lineageTag: 5e08371f-698b-4456-9ed4-ece5ca720611

	/// KPI card note for freight.
	measure 'Freight vs PY Label' =
			VAR _change = [Freight YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( 'Date'[Year] ), "Pick one year to compare",
			        ISBLANK ( _change ), "No prior-year data",
			        FORMAT ( _change, "▲ 0%;▼ 0%;0%" ) & " vs last year"
			    )
		displayFolder: Report
		lineageTag: a6ffd204-abe1-43ad-a7ca-7a31e6590024

	/// KPI card note for year-to-date net sales.
	measure 'Net Sales YTD vs PY Label' =
			VAR _change = [Net Sales YTD YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( 'Date'[Year] ), "Pick one year to compare",
			        ISBLANK ( _change ), "No prior-year data",
			        FORMAT ( _change, "▲ 0%;▼ 0%;0%" ) & " vs last year to date"
			    )
		displayFolder: Report
		lineageTag: b7b5580f-fe45-4b06-a3e2-8cd8660ac3cd

	/// KPI card note for the on-time rate.
	measure 'On-Time vs Target Label' =
			VAR _gap = [On-Time Gap]
			RETURN IF ( ISBLANK ( _gap ), "No shipped orders", FORMAT ( _gap * 100, "+0.0;-0.0;0.0" ) & " pts against the 95% target" )
		displayFolder: Report
		lineageTag: 9797c298-3895-410e-b846-2bc655e78262

	/// KPI card note for the discount rate.
	measure 'Discount Rate vs PY Label' =
			VAR _now = [Discount Rate]
			VAR _prior = [Discount Rate PY]
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( 'Date'[Year] ), "Pick one year to compare",
			        ISBLANK ( _prior ), "No prior-year data",
			        FORMAT ( ( _now - _prior ) * 100, "+0.0;-0.0;0.0" ) & " pts vs last year"
			    )
		displayFolder: Report
		lineageTag: bb155f7c-10fa-4243-a114-4ed006bba982

	/// Title on the customer profile page.
	measure 'Selected Customer' = IF ( HASONEVALUE ( Customer[Customer] ), VALUES ( Customer[Customer] ), "Pick a customer" )
		displayFolder: Report
		lineageTag: e4bddee2-5415-4963-a676-b99b25e0ba4b

	/// First detail line on the customer profile page: the contact and their role.
	measure 'Selected Customer Detail' =
			IF (
			    HASONEVALUE ( Customer[Customer ID] ),
			    SELECTEDVALUE ( Customer[Contact] ) & ", " & SELECTEDVALUE ( Customer[Contact Title] ),
			    "Right-click a customer anywhere in the report and choose Drill through."
			)
		displayFolder: Report
		lineageTag: b8915d03-a02a-4aa4-818d-1e70521ea10d

	/// Title on the product profile page.
	measure 'Selected Product' = IF ( HASONEVALUE ( 'Product'[Product] ), VALUES ( 'Product'[Product] ), "Pick a product" )
		displayFolder: Report
		lineageTag: e5c30d29-08fc-4cd0-9e31-04fd9d450ecc

	/// First detail line on the product profile page: category and pack size.
	measure 'Selected Product Detail' =
			IF (
			    HASONEVALUE ( 'Product'[Product ID] ),
			    SELECTEDVALUE ( 'Product'[Category] ) & "  ·  " & SELECTEDVALUE ( 'Product'[Pack Size] ),
			    "Right-click a product anywhere in the report and choose Drill through."
			)
		displayFolder: Report
		lineageTag: 57d51627-5865-4ffc-9893-73cf30ccdb08

	/// Net value of the orders in the current filter, from the order header. Use it beside order-level columns such as order ID and shipping status.
	measure 'Order Value' = SUM ( Orders[Order Value] )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: Sales
		lineageTag: 42101dec-6f1b-449b-b3b1-0ed25ef6107b

	/// Second detail line on the customer profile page: where the customer is and how long they have bought. Empty until one customer is selected.
	measure 'Selected Customer Place' =
			IF (
			    HASONEVALUE ( Customer[Customer ID] ),
			    SELECTEDVALUE ( Customer[City] ) & ", " & SELECTEDVALUE ( Customer[Country] ) & "  ·  Customer since "
			        & FORMAT ( SELECTEDVALUE ( Customer[First Order Date] ), "mmm yyyy" ),
			    ""
			)
		displayFolder: Report
		lineageTag: bac2381d-d0b0-4690-9423-25a62d36af2d

	/// Second detail line on the product profile page: list price and whether the product is still sold. Empty until one product is selected.
	measure 'Selected Product Price' =
			IF (
			    HASONEVALUE ( 'Product'[Product ID] ),
			    "List price " & FORMAT ( SELECTEDVALUE ( 'Product'[List Price] ), "\$#,0.00" ) & "  ·  " & SELECTEDVALUE ( 'Product'[Status] ),
			    ""
			)
		displayFolder: Report
		lineageTag: daec3399-ddf5-44dc-87a2-cddbd8e3142f

	/// Units sold minus units sold on the same dates last year. Blank when there is no prior year to compare with.
	measure 'Units Sold YoY' = IF ( NOT ISBLANK ( [Units Sold PY] ), [Units Sold] - [Units Sold PY] )
		formatString: +#,0;-#,0;0
		displayFolder: SalesTime comparison
		lineageTag: 52060c0a-1606-4493-bb0b-18796cb93534


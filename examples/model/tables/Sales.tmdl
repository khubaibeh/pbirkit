/// Fact: one row per order line. The source of every sales measure.
table Sales
	lineageTag: f9171415-4ec4-4ffa-b994-6b0817464b10

	column 'Order ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f6d807ca-be67-4cc5-97b9-fc7e7d90a098
		summarizeBy: none
		sourceColumn: Order ID

	column 'Product ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1967bc8e-7a1e-4810-8e61-9638e289ba10
		summarizeBy: none
		sourceColumn: Product ID

	column 'Customer ID'
		dataType: string
		isHidden
		lineageTag: 7f84e1fc-889b-4061-a64c-6170fea63d06
		summarizeBy: none
		sourceColumn: Customer ID

	column 'Employee ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fb95621d-1f2a-479f-8b0e-f265e8195235
		summarizeBy: none
		sourceColumn: Employee ID

	column 'Shipper ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 384395c3-a180-4323-8cb2-bcd25173264f
		summarizeBy: none
		sourceColumn: Shipper ID

	column 'Order Date'
		dataType: dateTime
		isHidden
		formatString: d mmm yyyy
		lineageTag: 7003871f-3890-402d-827f-fa01d902b6b7
		summarizeBy: none
		sourceColumn: Order Date

	column 'Unit Price'
		dataType: decimal
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 48f369c6-a264-4b12-9141-af9bf8c08f4d
		summarizeBy: none
		sourceColumn: Unit Price

	column Quantity
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 2cca7e30-e7d1-4566-992d-3b42f9d25bcb
		summarizeBy: sum
		sourceColumn: Quantity

	column Discount
		dataType: double
		isHidden
		formatString: 0%
		lineageTag: bc0254c1-56eb-4085-8da5-e8eca24b1395
		summarizeBy: none
		sourceColumn: Discount

	column 'Gross Amount'
		dataType: decimal
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a8626b34-75b5-4c23-b312-fdfe8e6c3b35
		summarizeBy: sum
		sourceColumn: Gross Amount

	column 'Net Amount'
		dataType: decimal
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 191d393f-7ffa-4d4f-a42f-66f316072a95
		summarizeBy: sum
		sourceColumn: Net Amount

	column 'Discount Band'
		dataType: string
		lineageTag: 9c6bff8e-1e83-4ae4-9a3f-df1387f84072
		summarizeBy: none
		sourceColumn: Discount Band
		sortByColumn: 'Discount Band Order'

	column 'Discount Band Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1a7030cb-4b6e-4014-b95e-35a9e254d7d6
		summarizeBy: none
		sourceColumn: Discount Band Order

	partition Sales = m
		mode: import
		source =
				let
				    Headers = Table.SelectColumns(OrderHeaders, {"orderID", "customerID", "employeeID", "shipperID", "orderDate"}),
				    Joined = Table.NestedJoin(OrderLines, {"orderID"}, Headers, {"orderID"}, "order", JoinKind.Inner),
				    Expanded = Table.ExpandTableColumn(Joined, "order", {"customerID", "employeeID", "shipperID", "orderDate"}),
				    Band = Table.AddColumn(
				        Expanded,
				        "Discount Band",
				        each if [discount] = 0 then "No discount"
				            else if [discount] <= 0.05 then "Up to 5%"
				            else if [discount] <= 0.10 then "6–10%"
				            else if [discount] <= 0.15 then "11–15%"
				            else if [discount] <= 0.20 then "16–20%"
				            else "21–25%",
				        type text
				    ),
				    BandOrder = Table.AddColumn(
				        Band,
				        "Discount Band Order",
				        each if [discount] = 0 then 0 else Number.RoundUp([discount] * 20),
				        Int64.Type
				    ),
				    Renamed = Table.RenameColumns(
				        BandOrder,
				        {
				            {"orderID", "Order ID"}, {"productID", "Product ID"}, {"unitPrice", "Unit Price"},
				            {"quantity", "Quantity"}, {"discount", "Discount"}, {"grossAmount", "Gross Amount"},
				            {"netAmount", "Net Amount"}, {"customerID", "Customer ID"}, {"employeeID", "Employee ID"},
				            {"shipperID", "Shipper ID"}, {"orderDate", "Order Date"}
				        }
				    )
				in
				    Renamed


{
	"name": "@pbirkit/core",
	"version": "0.3.1",
	"private": true,
	"description": "Core types and building blocks for pbirkit.",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#core/*.ts": "./src/*.ts",
		"#core/*": "./src/*/index.ts",
		"#schemas/*.ts": "./src/schemas/*.ts",
		"#schemas/*": "./src/schemas/*.ts"
	},
	"exports": {
		"./build": "./src/build/index.ts",
		"./check": "./src/check.ts",
		"./config": "./src/config.ts",
		"./custom-visual": "./src/custom-visual.ts",
		"./expr": "./src/expr/index.ts",
		"./font": "./src/font.ts",
		"./register": "./src/register.ts",
		"./resource": "./src/resource.ts",
		"./schemas/*": "./src/schemas/*.ts",
		"./schemas/*/shared": null,
		"./schemas/common/*": null,
		"./schemas/theme/*": null,
		"./schemas/visual-configuration/*": null,
		"./tree": "./src/tree/index.ts",
		"./visual-catalog": "./src/visual-catalog/index.ts",
		"./visual-type": "./src/visual-type.ts"
	},
	"scripts": {
		"visual-objects": "node scripts/visual-objects.ts",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@microsoft/powerbi-core-visual-schema": "catalog:",
		"effect": "catalog:"
	}
}

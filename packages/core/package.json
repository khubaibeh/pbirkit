{
	"name": "@pbirkit/core",
	"version": "0.0.0",
	"private": true,
	"description": "Core types and building blocks for pbirkit.",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#core/*.ts": "./src/*.ts",
		"#core/*": "./src/*/index.ts",
		"#schemas/*.ts": "./src/schemas/*.ts",
		"#schemas/*": "./src/schemas/*/index.ts"
	},
	"exports": {
		"./config": "./src/config.ts",
		"./filter-configuration/*": "./src/schemas/filter-configuration/*.ts",
		"./formatting-object-definitions/*": "./src/schemas/formatting-object-definitions/*.ts",
		"./model": "./src/schemas/model/index.ts",
		"./page/*": "./src/schemas/page/*.ts",
		"./report": "./src/schemas/report/index.ts",
		"./report-extension/*": "./src/schemas/report-extension/*.ts",
		"./schema-url": "./src/schemas/schema-url.ts",
		"./semantic-query/*": "./src/schemas/semantic-query/*.ts",
		"./visual/*": "./src/schemas/visual/*.ts"
	},
	"scripts": {
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"effect": "catalog:"
	}
}
